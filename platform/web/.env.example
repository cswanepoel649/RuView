# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key — safe for the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service role) key — SERVER ONLY. Used for gateway ingest, invites, device secrets.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public base URL of this app (used in emails, invite links, gateway install commands)
APP_URL=https://monitor.example.com

# 32-byte hex key that encrypts per-device OTA PSKs at rest (AES-256-GCM).
# Generate: openssl rand -hex 32   — rotate only with a re-encryption job.
DEVICE_SECRET_KEY=

# Bearer secret for /api/cron/* (Vercel Cron sends it automatically when set). openssl rand -hex 32
CRON_SECRET=

# Optional email delivery (Resend). Without it, email notifications are marked "skipped".
RESEND_API_KEY=
EMAIL_FROM="RuView Monitoring <alerts@monitor.example.com>"
